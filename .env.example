# Referência do projeto: trecho antes de .supabase.co na URL do projeto
SUPABASE_PROJECT_REF=seu-project-ref

# Credenciais da conexão PostgreSQL do Supabase
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.seu-project-ref
DB_PASSWORD=sua-senha-do-banco

# Supabase > Project Settings > API Keys
SUPABASE_PUBLIC_KEY=sua-chave-publishable
SECRET_KEY=sua-chave-secreta
